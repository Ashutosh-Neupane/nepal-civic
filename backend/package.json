{
  "name": "nepal-civic-backend",
  "version": "1.0.0",
  "description": "Nepal Civic grievance API: Province, District, Palika and Ward grievance handling.",
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--no-experimental-strip-types CAPTCHA_ENABLED=0 COMMUNICATIONS_TO_CONSOLE=1 ENFORCE_AUTHORIZATION=0 OTP_EXPOSE_IN_RESPONSE=1 nyc mocha --timeout 20000 --exit -r ts-node/register \"test/*.ts\" && nyc report --reporter=json > coverage.json",
    "start": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/default-server",
    "migrate": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/migrate-database",
    "generate-fake-data": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/generate-fake-data",
    "generate-dummy-data-for-jurisdiction": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/generate-dummy-data-for-jurisdiction",
    "send-test-email": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/send-test-email",
    "send-test-sms": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/send-test-sms",
    "send-test-dispatch": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/send-test-dispatch",
    "ensure-public-ids": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/ensure-public-ids",
    "ensure-service-request-inbound-map": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/ensure-service-request-inbound-map",
    "seed-nepal": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/seed-nepal",
    "create-super-admin": "NODE_OPTIONS=--no-experimental-strip-types ts-node ./src/cli/create-super-admin",
    "seed-demo": "node scripts/seed-demo.mjs"
  },
  "bin": {
    "civic-start": "./cli/default-server.js",
    "civic-migrate": "./cli/migrate-database.js",
    "civic-seed-nepal": "./cli/seed-nepal.js",
    "civic-create-super-admin": "./cli/create-super-admin.js"
  },
  "dependencies": {
    "@sendgrid/client": "^7.6.2",
    "@sendgrid/eventwebhook": "^7.4.5",
    "@sendgrid/mail": "^7.6.0",
    "@sentry/node": "^7.7.0",
    "@types/nodemailer": "^6.4.4",
    "axios": "^0.24.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "chai-as-promised": "^7.1.1",
    "cors": "^2.8.5",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^1.3.7",
    "deepmerge": "^4.2.2",
    "dotenv": "^10.0.0",
    "email-addresses": "^5.0.0",
    "email-forward-parser": "^1.8.3",
    "emittery": "^0.13.1",
    "express": "^4.17.1",
    "express-xml-bodyparser": "^0.3.0",
    "inversify": "^6.0.1",
    "jsonschema": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "log4js": "^6.7.1",
    "mailparser": "^3.5.0",
    "minio": "^7.0.32",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.7.2",
    "pg": "^8.7.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "6.7.0",
    "striptags": "^3.2.0",
    "umzug": "^3.0.0-beta.16",
    "validator": "^13.7.0",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@types/chai": "^4.2.22",
    "@types/chai-as-promised": "^7.1.5",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/express-xml-bodyparser": "^0.3.2",
    "@types/faker": "^5.5.9",
    "@types/jsonschema": "^1.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.14.176",
    "@types/mailparser": "^3.4.0",
    "@types/minio": "^7.0.11",
    "@types/mocha": "^9.0.0",
    "@types/multer": "^1.4.7",
    "@types/nconf": "^0.10.1",
    "@types/node": "^16.10.3",
    "@types/validator": "^13.6.5",
    "@types/xml2js": "^0.4.9",
    "@typescript-eslint/eslint-plugin": "^5.18.0",
    "@typescript-eslint/parser": "^5.18.0",
    "chai": "^4.3.4",
    "chai-http": "^4.3.0",
    "eslint": "^7.32.0",
    "eslint-plugin-react": "^7.26.0",
    "faker": "^5.5.3",
    "mocha": "^9.1.2",
    "nyc": "^15.1.0",
    "ts-node": "^10.7.0",
    "typescript": "^4.5.0"
  },
  "nyc": {
    "branches": "&gt;80",
    "lines": "&gt;80",
    "functions": "&gt;80",
    "statements": "&gt;80"
  },
  "directories": {
    "test": "test"
  },
  "private": true
}
