# --- App ---
APP_NAME=Nepal Civic
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000
APP_CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://postgres@localhost:5432/nepal_civic

# --- Auth ---
# Long random string, e.g. `openssl rand -hex 32`
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_HOURS=12
OTP_TTL_MINUTES=10
# 1 returns the OTP in the API response (local development only)
OTP_EXPOSE_IN_RESPONSE=0
ENFORCE_AUTHORIZATION=1

# --- Grievance workflow ---
ESCALATION_INTERVAL_MINUTES=5
RESOLVED_AUTO_CLOSE_DAYS=7

# --- SMS (Sparrow SMS) ---
SPARROW_SMS_TOKEN=
SMS_FROM_IDENTITY=
INBOUND_SMS_SECRET=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Print SMS and email to the console instead of sending
COMMUNICATIONS_TO_CONSOLE=1

# --- File storage: "local" or S3-compatible ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=nepal-civic-uploads
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_SSL=1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNED_GET_EXPIRY=60

# --- Spam protection ---
CAPTCHA_ENABLED=0
RECAPTCHA_SECRET_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
